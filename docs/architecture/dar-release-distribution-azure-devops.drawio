<mxfile host="Electron" modified="2026-08-18T12:00:00.000Z" agent="Codex drawio-skill" version="30.2.6">
  <diagram id="dar-release-architecture" name="End-to-End Architecture">
    <mxGraphModel dx="2200" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1440" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;DAR Release Distribution Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="2140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Private GitHub versioned ZIP + Azure DevOps Secure File cohort &#8594; derived manifest &#8594; private immutable snapshots &#8594; Service Bus &#8594; Go worker on Container Apps &#8594; Entra-authenticated download" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="2140" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="source_boundary" value="Source Control &amp; CI/CD (SaaS)" style="swimlane;startSize=36;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="380" height="1180" as="geometry"/>
        </mxCell>
        <mxCell id="github_repo" value="&lt;b&gt;Private GitHub Product Repository&lt;/b&gt;&lt;br&gt;Go source + Azure DevOps YAML&lt;br&gt;releases/vA.B.C.DD/dar-A.B.C.DD.zip&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;No product manifest &#8226; no recipient PII &#8226; no GitHub Actions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;dashed=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="source_boundary">
          <mxGeometry x="50" y="70" width="280" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="recipient_secure_file" value="&lt;b&gt;Azure DevOps Secure File&lt;/b&gt;&lt;br&gt;first_name &#8226; last_name &#8226; email&lt;br&gt;protected recipient cohort&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;Not stored in Git&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="source_boundary">
          <mxGeometry x="50" y="220" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="azure_pipeline" value="&lt;b&gt;Azure DevOps Pipeline&lt;/b&gt;&lt;br&gt;GitHub trigger: releases/** &#8226; LFS checkout&lt;br&gt;download protected Secure File&lt;br&gt;validate version folder + ZIP contents&lt;br&gt;derive manifest + deterministic JSONL batches&lt;br&gt;approval gate &#8226; publish snapshots" style="shape=label;image=img/lib/mscae/Azure_Pipelines.svg;imageWidth=48;imageHeight=48;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="source_boundary">
          <mxGeometry x="50" y="350" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="source_note" value="&lt;b&gt;PII / authority boundary&lt;/b&gt;&lt;br&gt;&#8226; Git contains source and approved release ZIPs only&lt;br&gt;&#8226; Secure File contains the protected recipient cohort&lt;br&gt;&#8226; Access is limited to release operators&lt;br&gt;&#8226; Azure DevOps validates, batches and publishes snapshots&lt;br&gt;&#8226; Pipeline cannot call SendGrid&lt;br&gt;&#8226; The email list never grants download access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=12;fontSize=10;" vertex="1" parent="source_boundary">
          <mxGeometry x="45" y="540" width="290" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="azure_boundary" value="Azure Subscription / Managed Runtime Boundary" style="swimlane;startSize=36;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#f8fbff;strokeColor=#0078d4;strokeWidth=2;fontColor=#005a9e;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="1310" height="1180" as="geometry"/>
        </mxCell>
        <mxCell id="ingest_group" value="Release Ingestion &amp; Durable Handoff" style="swimlane;startSize=30;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#eef6ff;strokeColor=#6c8ebf;fontColor=#35577a;fontStyle=1;fontSize=13;" vertex="1" parent="azure_boundary">
          <mxGeometry x="20" y="55" width="1270" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="private_agent" value="&lt;b&gt;Publisher Runner&lt;/b&gt;&lt;br&gt;Private Azure DevOps agent&lt;br&gt;private DNS + data-plane reachability&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;Auth: workload identity federation&lt;/font&gt;" style="shape=label;image=img/lib/azure2/compute/Automanaged_VM.svg;imageWidth=48;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=62;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="ingest_group">
          <mxGeometry x="30" y="55" width="280" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="blob_storage" value="&lt;b&gt;Blob Storage &#8212; Private Containers&lt;/b&gt;&lt;br&gt;Versioned release ZIP + generated manifests&lt;br&gt;Protected recipient batch snapshots&lt;br&gt;HMAC notification receipts&lt;br&gt;Optional immutable audit archive target&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;Anonymous access disabled &#8226; managed identity/RBAC&lt;/font&gt;" style="shape=label;image=img/lib/azure2/storage/Storage_Accounts.svg;imageWidth=46;imageHeight=46;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="ingest_group">
          <mxGeometry x="410" y="55" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ingest_note" value="Pipeline derives the internal manifest, converts the protected Secure File into deterministic JSONL batches, then conditionally uploads the release artifact, manifest and batch snapshots. Record SHA-256, ETag and Blob version IDs; queue messages contain references only&#8212;never names or email addresses." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;align=left;verticalAlign=middle;spacing=10;fontSize=9;" vertex="1" parent="ingest_group">
          <mxGeometry x="30" y="178" width="760" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="release_group" value="Release Distribution Control Plane" style="swimlane;startSize=30;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#fffaf0;strokeColor=#d6b656;fontColor=#8a6500;fontStyle=1;fontSize=13;" vertex="1" parent="azure_boundary">
          <mxGeometry x="20" y="315" width="1270" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="service_bus" value="" style="shape=mxgraph.azure.service_bus_queues;pointerEvents=1;html=1;strokeColor=none;fillColor=#00BEF2;" vertex="1" parent="ingest_group">
          <mxGeometry x="810" y="66" width="70" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="service_bus_label" value="&lt;b&gt;Azure Service Bus&lt;/b&gt;&lt;br&gt;Queue: dar-release-notifications&lt;br&gt;One message per recipient batch reference&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;Peek-Lock &#8226; duplicate detection &#8226; DLQ &#8226; no PII&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;fontSize=10;" vertex="1" parent="ingest_group">
          <mxGeometry x="900" y="55" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="container_apps_group" value="Azure Container Apps Environment" style="swimlane;startSize=26;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#eef6ff;strokeColor=#6c8ebf;fontColor=#35577a;fontStyle=1;fontSize=11;" vertex="1" parent="release_group">
          <mxGeometry x="850" y="25" width="350" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="distribution_worker" value="&lt;b&gt;Go Distribution Worker&lt;/b&gt;&lt;br&gt;Azure Container App &#8226; no public ingress&lt;br&gt;always-on minimum replicas set by SLO&lt;br&gt;Peek-Lock + bounded lock renewal&lt;br&gt;HMAC recipient ID &#8226; Blob CAS receipt&lt;br&gt;one recipient effect at a time" style="shape=label;image=img/lib/azure2/other/Worker_Container_App.svg;imageWidth=48;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=62;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="container_apps_group">
          <mxGeometry x="10" y="32" width="330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="bus_value" value="&lt;b&gt;Service Bus value&lt;/b&gt;&lt;br&gt;Durable handoff &#8226; buffering &#8226; Peek-Lock redelivery &#8226; bounded retries &#8226; dead-letter queue &#8226; workload isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="release_group">
          <mxGeometry x="30" y="55" width="260" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="poc_proof_note" value="&lt;b&gt;End-to-end proof &#8212; 18 Aug 2026&lt;/b&gt;&lt;br&gt;&#8226; Azure DevOps run 359 published v8.31.1.04&lt;br&gt;&#8226; SendGrid 202 + Outlook mailbox receipt&lt;br&gt;&#8226; Direct app URL; click/open tracking disabled&lt;br&gt;&#8226; Entra-authenticated 208-byte stream completed&lt;br&gt;&#8226; Receipt + download audit correlated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontSize=9;" vertex="1" parent="release_group">
          <mxGeometry x="30" y="190" width="260" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="key_vault" value="&lt;b&gt;Azure Key Vault&lt;/b&gt;&lt;br&gt;Receipt-HMAC key + version (tested)&lt;br&gt;SendGrid Mail-Send key (tested secret reference)" style="shape=label;image=img/lib/azure2/security/Key_Vaults.svg;imageWidth=42;imageHeight=42;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="release_group">
          <mxGeometry x="890" y="210" width="250" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="data_group" value="Database-Free Durable State (private containers in one storage account)" style="swimlane;startSize=30;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#f3fbf2;strokeColor=#82b366;fontColor=#376b36;fontStyle=1;fontSize=11;" vertex="1" parent="release_group">
          <mxGeometry x="310" y="170" width="540" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="release_manifests" value="&lt;b&gt;dar-releases/&lt;/b&gt;&lt;br&gt;{version}/{filename}&lt;br&gt;conditional create&lt;br&gt;strong ETag" style="shape=document;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="data_group">
          <mxGeometry x="15" y="42" width="155" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="recipient_batches" value="&lt;b&gt;recipient-batches/&lt;/b&gt;&lt;br&gt;canonical JSONL batches&lt;br&gt;private &#8226; versioned&lt;br&gt;bounded retention" style="shape=document;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="data_group">
          <mxGeometry x="195" y="42" width="150" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="notification_receipts" value="&lt;b&gt;notification-receipts/&lt;/b&gt;&lt;br&gt;release / operation / key version / HMAC ID&lt;br&gt;conditional state transitions&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;SIMULATED / ACCEPTED / UNKNOWN / FAILED&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=8;" vertex="1" parent="data_group">
          <mxGeometry x="370" y="42" width="155" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="data_note" value="No application database &#8226; container-scoped identities &#8226; app cannot read recipient batches &#8226; receipts contain no raw name or email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e8;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=8;" vertex="1" parent="data_group">
          <mxGeometry x="15" y="158" width="510" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="download_group" value="Authenticated Download Data Plane" style="swimlane;startSize=30;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#f7f3fb;strokeColor=#9673a6;fontColor=#674778;fontStyle=1;fontSize=13;" vertex="1" parent="azure_boundary">
          <mxGeometry x="20" y="725" width="1270" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="download_app" value="&lt;b&gt;Go DAR Download App&lt;/b&gt;&lt;br&gt;Azure Container App&lt;br&gt;trust only validated platform principal&lt;br&gt;strict {version}/{filename} Blob path&lt;br&gt;strong ETag + If-Match range streaming&lt;br&gt;structured started + terminal audit events&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;No database &#8226; no recipient-list access&lt;/font&gt;" style="shape=label;image=img/lib/azure2/other/Worker_Container_App.svg;imageWidth=48;imageHeight=46;imageAlign=left;imageVerticalAlign=middle;spacingLeft=62;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=middle;fontSize=8;" vertex="1" parent="download_group">
          <mxGeometry x="500" y="55" width="330" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="easy_auth" value="&lt;b&gt;Azure Container Apps Authentication&lt;/b&gt;&lt;br&gt;Microsoft Entra provider&lt;br&gt;redirect unauthenticated browsers&lt;br&gt;validate issuer / audience / expiry&lt;br&gt;inject validated principal headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="download_group">
          <mxGeometry x="870" y="55" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="auth_note" value="&lt;b&gt;Database-free authorization + download&lt;/b&gt;&lt;br&gt;1. Open the stable release URL&lt;br&gt;2. Container Apps authentication redirects to Microsoft Entra ID&lt;br&gt;3. Platform validates the returned identity token&lt;br&gt;4. App receives the validated subject&lt;br&gt;5. App selects {version}/{filename} and pins its ETag&lt;br&gt;6. App streams with If-Match and emits audit events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=10;fontSize=9;" vertex="1" parent="download_group">
          <mxGeometry x="30" y="55" width="420" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="download_note" value="Email and the recipient cohort never grant access. Microsoft Entra ID and Container Apps authentication own authentication; the Go app has no SQL connection. Session and revocation behavior follows the configured identity policy. A completed audit event means the server streamed all release bytes&#8212;not proof the file was saved or opened." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;align=left;verticalAlign=middle;spacing=10;fontSize=9;" vertex="1" parent="download_group">
          <mxGeometry x="30" y="215" width="1140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ops_group" value="Operations &amp; Audit" style="swimlane;startSize=26;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#444444;fontStyle=1;fontSize=12;" vertex="1" parent="azure_boundary">
          <mxGeometry x="20" y="1055" width="1270" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="monitor" value="&lt;b&gt;Azure Monitor / Log Analytics + Optional Immutable Export&lt;/b&gt;&lt;br&gt;Worker: HMAC recipient + receipt outcome &#8226; App: Entra subject + release version + filename + session ID + UTC time + bytes + outcome&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;Container Apps diagnostic logs &#8226; never sample audit events &#8226; production target: immutable/WORM export&lt;/font&gt;" style="shape=label;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="ops_group">
          <mxGeometry x="150" y="30" width="970" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="external_boundary" value="Identity, Email Provider &amp; Clients" style="swimlane;startSize=36;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1760" y="100" width="410" height="1180" as="geometry"/>
        </mxCell>
        <mxCell id="sendgrid" value="&lt;b&gt;Twilio SendGrid &#8212; Live POC Proven&lt;/b&gt;&lt;br&gt;Sandbox 200 &#8226; live Mail Send 202&lt;br&gt;Click/open tracking disabled&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;202 = accepted; mailbox observed separately&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="external_boundary">
          <mxGeometry x="65" y="420" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;Authorized Client&lt;/b&gt;&lt;br&gt;Mailbox + browser&lt;br&gt;Receives stable application URL&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;Email and URL do not grant access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="external_boundary">
          <mxGeometry x="65" y="760" width="280" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="entra_id" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;OIDC / OAuth authentication&lt;br&gt;issuer &#8226; subject &#8226; audience &#8226; expiry&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;Identity authority; no app-to-SQL path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="external_boundary">
          <mxGeometry x="65" y="910" width="280" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="external_note" value="&lt;b&gt;Client-facing guarantee&lt;/b&gt;&lt;br&gt;Only the authenticated application URL is emailed. Blob remains private; no SAS or storage credential reaches the client." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="external_boundary">
          <mxGeometry x="55" y="1060" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="1a  releases/** update + LFS checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;flowAnimationDuration=1200;flowAnimationTimingFunction=linear;flowAnimationDirection=normal;strokeColor=#0078d4;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=9;exitX=1;exitY=0.65;entryX=1;entryY=0.2;" edge="1" parent="1" source="github_repo" target="azure_pipeline">

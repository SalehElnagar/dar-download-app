        <mxCell id="e16" value="15  Stream release through authenticated response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;flowAnimationDuration=1200;flowAnimationTimingFunction=linear;flowAnimationDirection=normal;strokeColor=#0078d4;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.8;exitY=0;entryX=0;entryY=0.8;" edge="1" parent="1" source="download_app" target="client">

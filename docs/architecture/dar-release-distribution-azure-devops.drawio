  <diagram id="why-service-bus" name="Why Service Bus">
    <mxGraphModel dx="1800" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="w_title" value="&lt;b&gt;Why Put Service Bus Between Azure DevOps and Client Notification?&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="w_subtitle" value="Azure DevOps can read the protected recipient Secure File and call SendGrid directly. The decision is about PII boundaries, recovery and operational ownership—not technical possibility." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1720" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="comparison" value="Direct Azure DevOps vs. Service Bus + Worker" style="swimlane;startSize=40;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1720" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_h_concern" value="&lt;b&gt;Concern&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#6b7280;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="comparison">
          <mxGeometry x="20" y="50" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_h_direct" value="&lt;b&gt;Azure DevOps reads recipient Secure File + sends email&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="comparison">
          <mxGeometry x="260" y="50" width="690" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_h_queue" value="&lt;b&gt;Service Bus + Go Container App worker + Blob receipts&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="comparison">
          <mxGeometry x="950" y="50" width="750" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_c1" value="&lt;b&gt;Security boundary&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9ca3af;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="20" y="95" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_d1" value="The pipeline job workspace contains recipient PII and the pipeline also receives SendGrid-send permission." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#d79b00;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="260" y="95" width="690" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_q1" value="Pipeline uploads protected batches and enqueues references only; the worker holds narrow Blob-read, receipt-write and email permissions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6fff5;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="950" y="95" width="750" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_c2" value="&lt;b&gt;Temporary failure&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9ca3af;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="20" y="140" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_d2" value="SendGrid outage or throttling blocks or fails the release pipeline." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#d79b00;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="260" y="140" width="690" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_q2" value="The message remains durable, is retried with Peek-Lock and reaches the DLQ after bounded failures." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6fff5;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="950" y="140" width="750" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_c3" value="&lt;b&gt;Partial send&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9ca3af;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="20" y="185" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_d3" value="The pipeline must implement durable per-recipient state or cannot resume safely." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#d79b00;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="260" y="185" width="690" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_q3" value="Conditional Blob receipts store release/recipient status so the worker can continue from durable state without a database." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6fff5;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="950" y="185" width="750" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_c4" value="&lt;b&gt;Pipeline rerun&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9ca3af;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="20" y="230" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_d4" value="A blind rerun can duplicate accepted emails or skip clients that were never reached." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#d79b00;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="260" y="230" width="690" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_q4" value="Deterministic release/operation/key-version/HMAC-recipient receipt paths and conditional writes prevent blind reprocessing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6fff5;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="950" y="230" width="750" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_c5" value="&lt;b&gt;Scale and runtime&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9ca3af;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="20" y="275" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_d5" value="The build agent remains occupied and is exposed to job timeouts and email-rate limits." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#d79b00;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="260" y="275" width="690" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_q5" value="The worker can batch, throttle and scale independently from release execution." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6fff5;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="950" y="275" width="750" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_c6" value="&lt;b&gt;Ownership&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9ca3af;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="20" y="320" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_d6" value="CI/CD deployment and customer-facing business operations are mixed together." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#d79b00;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="260" y="320" width="690" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cmp_q6" value="Release publication and client distribution have separate failure and permission boundaries." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6fff5;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=10;fontSize=11;" vertex="1" parent="comparison">
          <mxGeometry x="950" y="320" width="750" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="recommendation" value="&lt;b&gt;Recommendation:&lt;/b&gt; use Service Bus + Go Container App worker + conditional Blob receipts. This preserves durable recovery without introducing an application database; direct pipeline sending still lacks an independent failure boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="500" width="1560" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="failure" value="Partial-send failure: 10,000 recipients" style="swimlane;startSize=40;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1720" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="direct_fail" value="Direct Azure DevOps path" style="swimlane;startSize=35;html=1;rounded=1;collapsible=0;horizontal=1;container=1;pointerEvents=0;fillColor=#fff5f5;strokeColor=#b85450;fontColor=#8b1e1e;fontStyle=1;fontSize=13;" vertex="1" parent="failure">
          <mxGeometry x="20" y="50" width="820" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="df1" value="&lt;b&gt;1&lt;/b&gt;&lt;br&gt;Blob upload succeeds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="direct_fail">
          <mxGeometry x="20" y="60" width="130" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="df2" value="&lt;b&gt;2&lt;/b&gt;&lt;br&gt;Read 10,000 CSV rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="direct_fail">
          <mxGeometry x="180" y="60" width="130" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="df3" value="&lt;b&gt;3&lt;/b&gt;&lt;br&gt;SendGrid accepts 4,000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="direct_fail">
          <mxGeometry x="340" y="60" width="130" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="df4" value="&lt;b&gt;4&lt;/b&gt;&lt;br&gt;SendGrid times out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="direct_fail">
          <mxGeometry x="500" y="60" width="130" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="df5" value="&lt;b&gt;5&lt;/b&gt;&lt;br&gt;Pipeline fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="direct_fail">
          <mxGeometry x="660" y="60" width="130" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="df_note" value="A rerun cannot know which accepted requests ultimately delivered. Without durable per-recipient state, it may resend accepted emails or skip clients that were never reached." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="direct_fail">
          <mxGeometry x="30" y="165" width="760" height="75" as="geometry"/>
        </mxCell>

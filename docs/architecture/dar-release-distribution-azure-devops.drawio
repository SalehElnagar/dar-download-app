        </mxCell>
        <mxCell id="qr_note" value="The worker uses CLAIMED / SEND_STARTED / RETRYABLE / ACCEPTED / SIMULATED / UNKNOWN / FAILED receipt states. Receipts use an HMAC-derived recipient ID, record the operation and key version, and contain no raw name or email. UNKNOWN outcomes require reconciliation or a deliberate retry policy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;align=left;verticalAlign=middle;spacing=12;fontSize=10;" vertex="1" parent="q_recovery">

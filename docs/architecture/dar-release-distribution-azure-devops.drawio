              <mxPoint x="385" y="250"/>
              <mxPoint x="385" y="480"/>
            </Array>
            <mxPoint x="0" y="0" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e1b" value="1b  Protected recipient input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;flowAnimationDuration=1200;flowAnimationTimingFunction=linear;flowAnimationDirection=normal;strokeColor=#b85450;strokeWidth=2;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=9;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="recipient_secure_file" target="azure_pipeline">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="2  Approved publication stage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;flowAnimationDuration=1200;flowAnimationTimingFunction=linear;flowAnimationDirection=normal;strokeColor=#0078d4;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="azure_pipeline" target="private_agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="3  Upload snapshots" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;flowAnimationDuration=1200;flowAnimationTimingFunction=linear;flowAnimationDirection=normal;strokeColor=#0078d4;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=9;exitX=1;exitY=0.45;entryX=0;entryY=0.45;" edge="1" parent="1" source="private_agent" target="blob_storage">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="4  Batch references only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;flowAnimationDuration=1200;flowAnimationTimingFunction=linear;flowAnimationDirection=normal;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.8;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="private_agent" target="service_bus">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="704" y="195"/>
              <mxPoint x="1295" y="195"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="5  Peek-Lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;flowAnimationDuration=1200;flowAnimationTimingFunction=linear;flowAnimationDirection=normal;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="service_bus_label" target="distribution_worker">

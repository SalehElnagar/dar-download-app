        <mxCell id="sendgrid" value="&lt;b&gt;SendGrid&lt;/b&gt;&lt;br&gt;One Mail Send request&lt;br&gt;Mail-Send-only API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_release">
          <mxGeometry x="870" y="220" width="260" height="95" as="geometry" />
        </mxCell>
        <mxCell id="distribution_group" value="&lt;b&gt;Exchange Online Distribution Group&lt;/b&gt;&lt;br&gt;&lt;b&gt;dar-release-notifications@dtcc.com&lt;/b&gt;&lt;br&gt;Closed membership • approved sender&lt;br&gt;Exchange owns fan-out and retries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_release">
          <mxGeometry x="1200" y="200" width="370" height="125" as="geometry" />

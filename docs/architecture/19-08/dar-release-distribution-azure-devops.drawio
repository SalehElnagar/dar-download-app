        <mxCell id="separation_note" value="&lt;b&gt;Notification ≠ authorization&lt;/b&gt; — the distribution group sends the link; the IDT role &lt;b&gt;dar_download&lt;/b&gt; grants download access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;" vertex="1" parent="1">

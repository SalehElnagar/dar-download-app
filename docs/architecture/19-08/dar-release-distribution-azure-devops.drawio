        </mxCell>
        <mxCell id="azure_devops" value="&lt;b&gt;Azure DevOps Pipeline&lt;/b&gt;&lt;br&gt;Validate version, ZIP and digest&lt;br&gt;Upload immutable release Blob&lt;br&gt;Build authenticated download URL&lt;br&gt;Send one notification email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_release">
          <mxGeometry x="430" y="75" width="340" height="170" as="geometry" />

        <mxCell id="participant_admin" value="&lt;b&gt;Participant Super Admin&lt;/b&gt;&lt;br&gt;Coordinator&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;Owns participant onboarding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=13;" vertex="1" parent="lane_onboarding">
          <mxGeometry x="70" y="65" width="290" height="105" as="geometry" />
        </mxCell>
        <mxCell id="idt_duende" value="&lt;b&gt;IDT / Duende IdentityServer&lt;/b&gt;&lt;br&gt;Authorization Code client: &lt;b&gt;dar-download&lt;/b&gt;&lt;br&gt;Authenticates users and emits trusted role claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_onboarding">
          <mxGeometry x="500" y="55" width="370" height="125" as="geometry" />
        </mxCell>
        <mxCell id="role_assignment" value="&lt;b&gt;Download Authorization Contract&lt;/b&gt;&lt;br&gt;Exact IDT role: &lt;b&gt;dar_download&lt;/b&gt;&lt;br&gt;Participant coordinator assigns and revokes it&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;No recipient database or application allowlist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_onboarding">
          <mxGeometry x="1050" y="55" width="690" height="125" as="geometry" />

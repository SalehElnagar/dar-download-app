        <mxCell id="lane_download" value="&lt;b&gt;C. Authenticated Download&lt;/b&gt;" style="swimlane;startSize=36;horizontal=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7f0;swimlaneFillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;fontSize=14;pointerEvents=0;" vertex="1" parent="1">

        <mxCell id="external_recipients" value="&lt;b&gt;External Recipients&lt;/b&gt;&lt;br&gt;Participant company DLs&lt;br&gt;or external mail contacts&lt;br&gt;Different domains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="lane_release">
          <mxGeometry x="1610" y="200" width="190" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3  New release triggers CI/CD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="lane_release" source="github_repo" target="azure_devops">

        <mxCell id="recipient_browser" value="&lt;b&gt;Notified Recipient&lt;/b&gt;&lt;br&gt;Browser opens emailed URL&lt;br&gt;&lt;font color=&quot;#6b7280&quot;&gt;The URL itself grants no access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="lane_download">
          <mxGeometry x="60" y="85" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="container_apps_auth" value="&lt;b&gt;Azure Container Apps Authentication&lt;/b&gt;&lt;br&gt;Uses the IDT / Duende provider above&lt;br&gt;Custom OIDC provider: &lt;b&gt;duende&lt;/b&gt;&lt;br&gt;Validates the session and injects protected principal + role claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_download">
          <mxGeometry x="430" y="65" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="download_app" value="&lt;b&gt;Go DAR Download App&lt;/b&gt;&lt;br&gt;Requires exact role: &lt;b&gt;dar_download&lt;/b&gt;&lt;br&gt;Missing role → 403&lt;br&gt;Logs subject + version + UTC outcome&lt;br&gt;Streams ZIP; no database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_download">
          <mxGeometry x="870" y="55" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="download_blob" value="&lt;b&gt;Private Blob Storage&lt;/b&gt;&lt;br&gt;Same release storage shown above&lt;br&gt;ETag-pinned range reads&lt;br&gt;No SAS exposed to clients" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_download">
          <mxGeometry x="1340" y="80" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="8  Open URL / sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="lane_download" source="recipient_browser" target="container_apps_auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="9  Trusted principal + role claim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="lane_download" source="container_apps_auth" target="download_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="10  Role allowed: read ZIP with managed identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.45;entryX=0;entryY=0.5;" edge="1" parent="lane_download" source="download_app" target="download_blob">

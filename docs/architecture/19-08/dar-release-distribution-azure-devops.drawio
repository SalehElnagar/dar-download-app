        <mxCell id="lane_release" value="&lt;b&gt;B. Release Publication and One-Message Notification&lt;/b&gt;" style="swimlane;startSize=36;horizontal=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e3a8a;fontSize=14;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1820" height="350" as="geometry" />
        </mxCell>
        <mxCell id="github_repo" value="&lt;b&gt;Private GitHub Repository&lt;/b&gt;&lt;br&gt;Go source + versioned ZIP only&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;releases/v8.31.1.01/&lt;br&gt;dar-8.31.1.01.zip&lt;/font&gt;&lt;br&gt;&lt;b&gt;No recipient data&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="lane_release">
